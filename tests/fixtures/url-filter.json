{
  "about": "Shared cases for MNFST_ALLOWLIST / MNFST_DENYLIST. The same file runs in manifest-node, manifest-python, manifest-php and manifest-hermes; change it in all four at once.",
  "parse": [
    { "entry": "stripe.com", "rule": { "host": "stripe.com", "path": null } },
    { "entry": "  Stripe.COM  ", "rule": { "host": "stripe.com", "path": null } },
    { "entry": "*.stripe.com", "rule": { "host": "stripe.com", "path": null } },
    { "entry": ".stripe.com.", "rule": { "host": "stripe.com", "path": null } },
    { "entry": "stripe.com/", "rule": { "host": "stripe.com", "path": null } },
    { "entry": "stripe.com:8443", "rule": { "host": "stripe.com", "path": null } },
    { "entry": "stripe.com/v1/charges", "rule": { "host": "stripe.com", "path": "/v1/charges" } },
    { "entry": "stripe.com/v1/charges/", "rule": { "host": "stripe.com", "path": "/v1/charges" } },
    { "entry": "https://API.Stripe.com/v1/Charges", "rule": { "host": "api.stripe.com", "path": "/v1/Charges" } },
    { "entry": "http://api.stripe.com:8443/v1/charges?limit=3#top", "rule": { "host": "api.stripe.com", "path": "/v1/charges" } },
    { "entry": "https://api.stripe.com", "rule": { "host": "api.stripe.com", "path": null } },
    { "entry": "localhost:3000/api", "rule": { "host": "localhost", "path": "/api" } },
    { "entry": "[::1]:8080/x", "rule": { "host": "::1", "path": "/x" } },
    { "entry": "", "rule": null, "invalid": false },
    { "entry": "   ", "rule": null, "invalid": false },
    { "entry": "stripe.com/v1/customers/*/sources", "rule": null, "invalid": true },
    { "entry": "/v1/charges", "rule": null, "invalid": true },
    { "entry": "https://", "rule": null, "invalid": true },
    { "entry": "user@stripe.com", "rule": null, "invalid": true },
    { "entry": "stri pe.com", "rule": null, "invalid": true }
  ],
  "match": [
    { "deny": "stripe.com", "url": "https://stripe.com/v1", "excluded": true },
    { "deny": "stripe.com", "url": "https://api.stripe.com/v1", "excluded": true },
    { "deny": "stripe.com", "url": "https://notstripe.com/v1", "excluded": false },
    { "deny": "stripe.com", "url": "https://API.Stripe.COM:8443/x", "excluded": true },
    { "deny": "stripe.com", "url": "https://api.stripe.com./x", "excluded": true },
    { "deny": "stripe.com/v1/charges", "url": "https://api.stripe.com/v1/charges", "excluded": true },
    { "deny": "stripe.com/v1/charges", "url": "https://api.stripe.com/v1/charges/ch_123", "excluded": true },
    { "deny": "stripe.com/v1/charges", "url": "https://api.stripe.com/v1/charges/", "excluded": true },
    { "deny": "stripe.com/v1/charges", "url": "https://api.stripe.com/v1/charges?limit=3", "excluded": true },
    { "deny": "stripe.com/v1/charges", "url": "https://api.stripe.com/v1/charges_export", "excluded": false },
    { "deny": "stripe.com/v1/charges", "url": "https://api.stripe.com/v1/customers", "excluded": false },
    { "deny": "stripe.com/v1/charges", "url": "https://api.stripe.com/", "excluded": false },
    { "deny": "stripe.com/v1/charges", "url": "https://api.stripe.com", "excluded": false },
    { "deny": "stripe.com/v1/Charges", "url": "https://api.stripe.com/v1/charges", "excluded": false },
    { "deny": "https://api.stripe.com/v1", "url": "https://files.api.stripe.com/v1/x", "excluded": true },
    { "deny": "https://api.stripe.com/v1", "url": "https://files.stripe.com/v1/x", "excluded": false },
    { "deny": "[::1]", "url": "http://[::1]:8080/x", "excluded": true },
    { "allow": "stripe.com", "url": "https://api.stripe.com/v1/charges", "excluded": false },
    { "allow": "stripe.com", "url": "https://api.openai.com/v1/chat", "excluded": true },
    { "allow": "stripe.com/v1/payment_intents", "url": "https://api.stripe.com/v1/payment_intents/pi_1", "excluded": false },
    { "allow": "stripe.com/v1/payment_intents", "url": "https://api.stripe.com/v1/charges", "excluded": true },
    { "allow": "stripe.com, openai.com/v1/chat", "url": "https://api.openai.com/v1/chat/completions", "excluded": false },
    { "allow": "stripe.com, openai.com/v1/chat", "url": "https://api.openai.com/v1/files", "excluded": true },
    { "allow": "stripe.com", "deny": "stripe.com/v1/charges", "url": "https://api.stripe.com/v1/charges", "excluded": true },
    { "allow": "stripe.com", "deny": "stripe.com/v1/charges", "url": "https://api.stripe.com/v1/refunds", "excluded": false },
    { "allow": "stripe.com/v1/*", "url": "https://api.stripe.com/v1/charges", "excluded": true },
    { "allow": " , ", "url": "https://api.openai.com/", "excluded": false },
    { "url": "https://api.openai.com/", "excluded": false },
    { "allow": "stripe.com", "url": "not a url", "excluded": false }
  ]
}
