#!/usr/bin/env php
<?php declare(strict_types=1);

foreach ([__DIR__ . '/../../../autoload.php', __DIR__ . '/../vendor/autoload.php'] as $autoload) {
    if (is_file($autoload)) {
        require $autoload;
        break;
    }
}

$root = (string) getcwd();

[$config, $keyFrom] = Mnfst\Doctor::config($root);

exit(Mnfst\Doctor::run($argv, $config, $root, $keyFrom));
